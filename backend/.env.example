# Zorunlu: uygulama async sürücü kullanır (parolayı kendiniz belirleyin)
DATABASE_URL=postgresql+asyncpg://mars_user:PAROLA@localhost:5432/mars_rover_db

# Alembic senkron sürücü ister. Boş bırakılırsa DATABASE_URL otomatik çevrilir.
DATABASE_URL_SYNC=postgresql://mars_user:PAROLA@localhost:5432/mars_rover_db

# https://api.nasa.gov — ücretsiz. Boşsa resmi DEMO_KEY kullanılır (saatlik ~30).
# Kişisel anahtar: api.nasa.gov → Generate API Key → buraya yapıştırın.
NASA_API_KEY=DEMO_KEY

# https://console.groq.com/keys — Rover AI (yoksa sessizce fallback)
GROQ_API_KEY=

# Yazma yapan uçları (POST/PATCH) korur. Boş bırakılırsa bu uçlar 503 ile kapalıdır.
SENTINEL_API_TOKEN=

# Aynı değeri frontend/.env içine VITE_API_TOKEN olarak yazın; Vite yeniden başlatılmalıdır.

# CORS: virgülle ayrılmış origin listesi. Üretimde kendi adresinizi yazın.
# CORS_ALLOW_ORIGINS=http://sunucu-adresiniz,http://localhost:5173

# Simülasyon turu aralığı (sn) ve Groq düşünce öncesi bekleme (sn)
# SENTINEL_SIM_INTERVAL_SECONDS=10
# (Geriye dönük: NIRVANA_SIM_INTERVAL_SECONDS da kabul edilir.)
# ROVER_THINK_DELAY_SECONDS=10

# Uplink drain hızı: her turda kuyruktan gönderilecek azami paket sayısı.
# Simülasyon 12 kanal ürettiği için düşük değerler kuyruğun büyümesine yol açar.
# SENTINEL_UPLINK_DRAIN_BATCH=12
